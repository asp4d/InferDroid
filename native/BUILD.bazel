# Overlay copied into the pinned LiteRT-LM checkout as //inferdroid.
# Dependencies mirror runtime/engine:litert_lm_main at 0b98b80e1d846af27d10b8ab395645119cb231e4.
cc_binary(
    name = "libinferdroid_litertlm.so",
    srcs = ["runtime_adapter.cc", "runtime_api.h"],
    linkshared = True,
    linkstatic = True,
    linkopts = [
        "-Wl,--no-undefined",
        "-Wl,--export-dynamic-symbol=LiteRt*",
        "-Wl,-soname,libinferdroid_litertlm.so",
        "-Wl,-z,max-page-size=16384",
        "-Wl,-z,common-page-size=16384",
        "-lEGL", "-lGLESv3", "-llog", "-ldl",
    ],
    deps = [
        "//runtime/engine:engine_factory",
        "//runtime/engine:engine_impl_selected",
        "//runtime/engine:engine_interface",
        "//runtime/engine:engine_settings",
        "//runtime/engine:io_types",
        "//runtime/conversation",
        "//runtime/conversation:io_types",
        "//runtime/executor:executor_settings_base",
        "//runtime/executor:llm_executor_settings",
        "//runtime/util:logging",
        "//runtime/util:litert_status_util",
        "//runtime/util:scoped_file",
        "@com_google_absl//absl/status",
        "@com_google_absl//absl/status:statusor",
        "@nlohmann_json//:json",
    ],
)
