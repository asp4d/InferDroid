<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/content"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:drawableStart="@drawable/inferdroid_logo_header"
                android:drawablePadding="12dp"
                android:text="@string/app_name"
                android:textSize="28sp"
                android:textStyle="bold" />
            <ImageButton
                android:id="@+id/btn_ui_settings"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="12dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_settings"
                android:contentDescription="@string/ui_settings_title" />
        </LinearLayout>
        <TextView android:id="@+id/backend_status" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/backend_label" android:textSize="16sp" />
        <TextView android:id="@+id/notification_status" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textSize="13sp" android:visibility="gone" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:text="@string/model_help" />
        <Button android:id="@+id/choose_model" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/choose_model" />
        <EditText android:id="@+id/model_source" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:hint="@string/model_hint"
            android:inputType="textUri" android:maxLines="4" android:textSize="13sp"
            android:importantForAutofill="no" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" style="?android:attr/buttonBarStyle">
            <Button android:id="@+id/load_model" style="?android:attr/buttonBarButtonStyle"
                android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:text="@string/load_model" />
            <Button android:id="@+id/unload" style="?android:attr/buttonBarButtonStyle"
                android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:text="@string/unload" />
        </LinearLayout>
        <EditText android:id="@+id/prompt" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:hint="@string/prompt_hint"
            android:text="@string/default_prompt" android:inputType="textMultiLine|textCapSentences"
            android:gravity="top" android:minLines="3" android:maxLines="8"
            android:importantForAutofill="no" />
        <CheckBox android:id="@+id/verbose" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:checked="true" android:text="@string/verbose" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" style="?android:attr/buttonBarStyle">
            <Button android:id="@+id/cancel" style="?android:attr/buttonBarButtonStyle"
                android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:text="@string/cancel" />
            <Button android:id="@+id/run" style="?android:attr/buttonBarButtonStyle"
                android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:text="@string/run" />
        </LinearLayout>
        <TextView android:id="@+id/status" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:accessibilityLiveRegion="polite"
            android:textSize="16sp" android:paddingTop="8dp" android:paddingBottom="8dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="@string/speech_label" android:textStyle="bold" android:textSize="18sp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/speech_help" />
        <Button android:id="@+id/import_speech_model" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/import_speech_model" />
        <TextView android:id="@+id/speech_model_status" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/speech_model_missing" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" style="?android:attr/buttonBarStyle">
            <Button android:id="@+id/load_speech_model" style="?android:attr/buttonBarButtonStyle"
                android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/load_speech_model" />
            <Button android:id="@+id/unload_speech_model" style="?android:attr/buttonBarButtonStyle"
                android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/unload_speech_model" />
        </LinearLayout>
        <Button android:id="@+id/choose_audio" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/choose_audio" />
        <TextView android:id="@+id/audio_source" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/audio_not_selected" android:textIsSelectable="true" android:textSize="13sp" />
        <EditText android:id="@+id/speech_language" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:hint="@string/speech_language" android:inputType="text"
            android:maxLength="3" android:singleLine="true" android:importantForAutofill="no" />
        <Button android:id="@+id/transcribe_audio" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/transcribe_audio" />
        <TextView android:id="@+id/speech_status" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/speech_model_missing" android:accessibilityLiveRegion="polite" android:paddingTop="8dp" />
        <TextView android:id="@+id/transcript" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textIsSelectable="true" android:textSize="17sp" android:minHeight="32dp" android:paddingTop="8dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="@string/server_label" android:textStyle="bold" android:textSize="18sp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/server_help" />
        <EditText android:id="@+id/server_port" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:hint="@string/server_port"
            android:inputType="number" android:maxLength="5" android:singleLine="true" android:importantForAutofill="no" />
        <CheckBox android:id="@+id/require_api_key" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/require_api_key" android:checked="true" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <EditText android:id="@+id/api_key" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:hint="@string/api_key"
                android:inputType="textPassword" android:singleLine="true" android:maxLength="256" android:importantForAutofill="no" />
            <ImageButton android:id="@+id/toggle_api_key_visibility"
                android:layout_width="48dp" android:layout_height="48dp" android:padding="12dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_visibility" android:contentDescription="@string/show_api_key" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" style="?android:attr/buttonBarStyle">
            <Button android:id="@+id/copy_key" style="?android:attr/buttonBarButtonStyle"
                android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/copy_key" />
            <Button android:id="@+id/regenerate_key" style="?android:attr/buttonBarButtonStyle"
                android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/regenerate_key" />
        </LinearLayout>
        <CheckBox android:id="@+id/cors" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/cors" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" style="?android:attr/buttonBarStyle">
            <Button android:id="@+id/start_server" style="?android:attr/buttonBarButtonStyle"
                android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/start_server" />
            <Button android:id="@+id/stop_server" style="?android:attr/buttonBarButtonStyle"
                android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/stop_server" />
        </LinearLayout>
        <TextView android:id="@+id/server_status" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/server_stopped" android:textIsSelectable="true"
            android:accessibilityLiveRegion="polite" android:paddingBottom="12dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/output_label" android:textStyle="bold" />
        <TextView android:id="@+id/output" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textIsSelectable="true"
            android:textSize="17sp" android:minHeight="64dp" android:paddingTop="8dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:text="@string/diagnostics_label" android:textStyle="bold" />
        <TextView android:id="@+id/diagnostics" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textIsSelectable="true"
            android:fontFamily="monospace" android:textSize="12sp" android:paddingTop="8dp" />
    </LinearLayout>
</ScrollView>
